{
  "name": "martini-shot",
  "version": "0.1.0",
  "description": "A local-first autonomous music video director.",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm:dev:main\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on tcp:5173 file:dist-electron/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "tsc -b && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "dist": "npm run build && electron-builder --win nsis",
    "validate:workflows": "node tools/validate-workflows.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.main.json --noEmit",
    "test:main": "npm run build:main && node --test dist-electron/workflow-template.test.js dist-electron/project-rules.test.js dist-electron/create-project-workflow.test.js dist-electron/plan-rules.test.js dist-electron/location-rules.test.js dist-electron/production-rules.test.js dist-electron/results-rules.test.js dist-electron/remote-render-staging.test.js"
  },
  "build": {
    "appId": "local.martinishot.app",
    "productName": "Martini Shot",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "workflows/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "dotenv": "^18.0.9",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "lucide-react": "^1.67.0",
    "typescript": "latest",
    "wait-on": "latest"
  }
}
