{
  "name": "02b-apply-timeline.json",
  "stage": "plan",
  "description": "Applies the saved song timeline (timeline.json) to the current story plan and has the local director LLM rewrite the story of sections the user split, merged, created, or deleted. Used by Save timeline when a plan exists.",
  "prompt": {
    "open": {
      "class_type": "MartiniShotOpenProject",
      "inputs": { "project_name": "{{project_name}}" }
    },
    "llm": {
      "class_type": "MiniMaxH3PromptLLMLoader",
      "inputs": { "model": "{{director_llm}}" }
    },
    "apply": {
      "class_type": "MartiniShotApplyTimeline",
      "inputs": {
        "project": ["open", 0],
        "llm": ["llm", 0],
        "section_sources": "{{section_sources}}",
        "seed": "{{seed}}",
        "story_system": "{{prompt_story_system}}",
        "section_rewrite_rules": "{{prompt_section_rewrite_rules}}",
        "timeline_shot_rules": "{{prompt_timeline_shot_rules}}"
      }
    },
    "report": {
      "class_type": "PreviewAny",
      "inputs": { "source": ["apply", 0] }
    }
  }
}
