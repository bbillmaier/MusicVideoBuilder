{
  "name": "02-plan-story.json",
  "stage": "plan",
  "description": "Plans the story for a saved Martini Shot project with the local director LLM and writes story_plan.json. Used by Create director plan and Reroll plan.",
  "prompt": {
    "open": {
      "class_type": "MartiniShotOpenProject",
      "inputs": { "project_name": "{{project_name}}" }
    },
    "llm": {
      "class_type": "MiniMaxH3PromptLLMLoader",
      "inputs": { "model": "{{director_llm}}" }
    },
    "plan": {
      "class_type": "MartiniShotPlanStory",
      "inputs": {
        "project": ["open", 0],
        "llm": ["llm", 0],
        "creative_brief": "{{creative_brief}}",
        "story_brief": "{{story_brief}}",
        "story_wheel": "{{story_wheel}}",
        "min_locations": "{{min_locations}}",
        "request_performer_location_images": "{{request_location_images}}",
        "seed": "{{seed}}",
        "reset_plan_cache": "{{reset_plan_cache}}"
      }
    },
    "report": {
      "class_type": "PreviewAny",
      "inputs": { "source": ["plan", 1] }
    },
    "needs_location_images": {
      "class_type": "PreviewAny",
      "inputs": { "source": ["plan", 2] }
    }
  }
}
