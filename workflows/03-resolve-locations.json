{
  "name": "03-resolve-locations.json",
  "stage": "resolve_locations",
  "description": "Re-checks the project's requested performer-location image files against the saved story plan and writes resolved_plan.json. Used by Check for images. Never runs the story planner.",
  "prompt": {
    "open": {
      "class_type": "MartiniShotOpenProject",
      "inputs": { "project_name": "{{project_name}}" }
    },
    "story": {
      "class_type": "MartiniShotLoadStoryPlan",
      "inputs": { "project": ["open", 0] }
    },
    "resolve": {
      "class_type": "MartiniShotResolveLocations",
      "inputs": {
        "project": ["open", 0],
        "story_plan": ["story", 0]
      }
    },
    "report": {
      "class_type": "PreviewAny",
      "inputs": { "source": ["resolve", 1] }
    },
    "ready_to_produce": {
      "class_type": "PreviewAny",
      "inputs": { "source": ["resolve", 2] }
    }
  }
}
