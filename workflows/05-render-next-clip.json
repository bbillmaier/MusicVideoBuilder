{
  "name": "05-render-next-clip.json",
  "stage": "render_clip",
  "description": "Renders exactly one clip of a saved Martini Shot prompt package in one 1 MP MiniMax H3 pass. It clears VRAM/RAM after reference encoding, after sampling, and after decode before saving. Submitted once per queued clip.",
  "prompt": {
    "clip": {
      "class_type": "MartiniShotLoadRenderClip",
      "inputs": {
        "render_package": { "__value__": "{{render_package}}" },
        "mode": "{{loader_mode}}",
        "clip_index": "{{clip_index}}"
      }
    },
    "clip_report": {
      "class_type": "PreviewAny",
      "inputs": { "source": ["clip", 13] }
    },
    "noise": {
      "class_type": "RandomNoise",
      "inputs": { "noise_seed": "{{noise_seed}}" }
    },
    "resolution": {
      "class_type": "MartiniShotRenderResolution",
      "inputs": { "aspect_ratio": "{{aspect_ratio}}", "megapixels": "{{render_megapixels}}", "multiple": 32 }
    },
    "unet": {
      "class_type": "UNETLoader",
      "inputs": { "unet_name": "singularityV2X10eros_prismPIKA.safetensors", "weight_dtype": "default" }
    },
    "shift": {
      "class_type": "MiniMaxH3SigmaShift",
      "inputs": { "model": ["unet", 0], "shift_video": "{{renderShiftVideo}}", "shift_audio": "{{renderShiftAudio}}" }
    },
    "live_preview": {
      "class_type": "MartiniShotLivePreview",
      "inputs": {
        "model": ["shift", 0],
        "enabled": "{{livePreviews}}",
        "max_resolution": 768,
        "jpeg_quality": 70,
        "preview_frames": 6,
        "preview_fps": 12,
        "tiny_vae": "taeh3.safetensors"
      }
    },
    "text_encoder": {
      "class_type": "CLIPLoader",
      "inputs": { "clip_name": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors", "type": "minimax", "device": "default" }
    },
    "video_vae": {
      "class_type": "VAELoader",
      "inputs": { "vae_name": "minimax_h3_video_vae_fp16.safetensors" }
    },
    "audio_vae": {
      "class_type": "VAELoader",
      "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" }
    },
    "ref2v": {
      "class_type": "MiniMaxH3ReferenceToVideo",
      "inputs": {
        "clip": ["text_encoder", 0],
        "vae": ["video_vae", 0],
        "audio_vae": ["audio_vae", 0],
        "prompt": ["clip", 0],
        "width": ["resolution", 0],
        "height": ["resolution", 1],
        "length": ["clip", 9],
        "ref_image_size": "match",
        "ref_images.ref_image_0": ["clip", 1],
        "ref_images.ref_image_1": ["clip", 2],
        "ref_images.ref_image_2": ["clip", 3],
        "ref_images.ref_image_3": ["clip", 4],
        "ref_images.ref_image_4": ["clip", 5],
        "ref_audios.ref_audio_0": ["clip", 6]
      }
    },
    "guide_1": {
      "class_type": "MiniMaxH3AddGuide",
      "inputs": {
        "positive": ["ref2v", 0],
        "latent": ["ref2v", 1],
        "vae": ["video_vae", 0],
        "audio_vae": ["audio_vae", 0],
        "image": ["clip", 8],
        "audio": ["clip", 6],
        "frame_idx": 0
      }
    },
    "vram_cleanup_before_sample": {
      "class_type": "VRAMCleanup",
      "inputs": { "anything": ["ref2v", 1], "offload_model": "{{vramCleanup}}", "offload_cache": "{{vramCleanup}}" }
    },
    "ram_cleanup_before_sample": {
      "class_type": "RAMCleanup",
      "inputs": { "anything": ["vram_cleanup_before_sample", 0], "clean_file_cache": "{{ramCleanup}}", "clean_processes": "{{ramCleanup}}", "clean_dlls": "{{ramCleanup}}", "retry_times": 3 }
    },
    "sampler": {
      "class_type": "KSamplerSelect",
      "inputs": { "sampler_name": "{{renderSampler}}" }
    },
    "sigmas_1": {
      "class_type": "BasicScheduler",
      "inputs": { "model": ["shift", 0], "scheduler": "{{renderScheduler}}", "steps": "{{render_steps}}", "denoise": 1.0 }
    },
    "guider_1": {
      "class_type": "BasicGuider",
      "inputs": { "model": ["live_preview", 0], "conditioning": ["guide_1", 0] }
    },
    "pass_1": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": ["noise", 0],
        "guider": ["guider_1", 0],
        "sampler": ["sampler", 0],
        "sigmas": ["sigmas_1", 0],
        "latent_image": ["ram_cleanup_before_sample", 0]
      }
    },
    "vram_cleanup_after_sample": {
      "class_type": "VRAMCleanup",
      "inputs": { "anything": ["pass_1", 1], "offload_model": "{{vramCleanup}}", "offload_cache": "{{vramCleanup}}" }
    },
    "ram_cleanup_after_sample": {
      "class_type": "RAMCleanup",
      "inputs": { "anything": ["vram_cleanup_after_sample", 0], "clean_file_cache": "{{ramCleanup}}", "clean_processes": "{{ramCleanup}}", "clean_dlls": "{{ramCleanup}}", "retry_times": 3 }
    },
    "decode": {
      "class_type": "VAEDecode",
      "inputs": { "samples": ["ram_cleanup_after_sample", 0], "vae": ["video_vae", 0] }
    },
    "vram_cleanup_after_decode": {
      "class_type": "VRAMCleanup",
      "inputs": { "anything": ["decode", 0], "offload_model": "{{vramCleanup}}", "offload_cache": "{{vramCleanup}}" }
    },
    "ram_cleanup_after_decode": {
      "class_type": "RAMCleanup",
      "inputs": { "anything": ["vram_cleanup_after_decode", 0], "clean_file_cache": "{{ramCleanup}}", "clean_processes": "{{ramCleanup}}", "clean_dlls": "{{ramCleanup}}", "retry_times": 3 }
    },
    "trim": {
      "class_type": "MiniMaxH3TrimOverlap",
      "inputs": { "images": ["ram_cleanup_after_decode", 0], "trim_frames": ["clip", 10], "trim_end": ["clip", 11] }
    },
    "video": {
      "class_type": "CreateVideo",
      "inputs": { "images": ["trim", 0], "audio": ["clip", 7], "fps": 24.0, "bit_depth": "auto", "color_space": "sRGB", "codec": "none" }
    },
    "save": {
      "class_type": "SaveVideo",
      "inputs": { "video": ["video", 0], "filename_prefix": ["clip", 12], "format": "mp4", "format.codec": "auto" }
    }
  }
}
