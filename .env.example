# The local ComfyUI server that will execute Martini Shot workflows.
COMFYUI_URL=http://127.0.0.1:8188

# Optional: change where Martini Shot keeps its self-managed SQLite database.
# Default: %APPDATA%\Martini Shot\martini-shot.db
# MARTINI_SHOT_DATA_DIR=D:\MartiniShotData

# Optional: the running ComfyUI's output folder (also editable in Settings).
# Martini Shot projects live in <this folder>\martini_shot\<project-slug>.
# COMFYUI_OUTPUT_DIR=E:\LTX2-Install\ComfyUI_windows_portable\ComfyUI\output
